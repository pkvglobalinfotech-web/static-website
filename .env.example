# PKV Global Infotech Environment Configuration Template
# Copy this to .env and configure for your deployment environment.

# Django Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,pkvglobalinfotech.com,www.pkvglobalinfotech.com,static-website-does.onrender.com
CSRF_TRUSTED_ORIGINS=https://pkvglobalinfotech.com,https://www.pkvglobalinfotech.com,https://static-website-does.onrender.com

# Database (Optional: falls back to SQLite db.sqlite3 if omitted)
# DATABASE_URL=postgres://username:password@hostname:5432/dbname

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@pkvglobalinfotech.com

# Monitored Company Inbox where staff receive customer enquiries
NOTIFICATION_EMAIL=contact@pkvglobalinfotech.com
